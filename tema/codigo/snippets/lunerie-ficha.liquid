{%- comment -%}
  Lunerie · partes a medida de la ficha de producto (se pintan desde secciones «Liquid personalizado» de
  templates/product.json; ver `parte()` en tema/build.py).
  Uso: {% render 'lunerie-ficha', parte: 'historia', product: product %}
  · historia: debajo de la ficha, como Olivia Jewelry — foto grande · franja con tres datos · texto · collage.
    Solo para el reloj Lune (el collar tendrá la suya). Las fotos son archivos de Shopify (Contenido → Archivos)
    con nombre fijo: lune-editorial-detalle / perfil / curva / toalla / pelo .jpg. Para cambiar una foto, subir otra
    con el mismo nombre (o cambiar aquí el nombre).
  OJO: nada de «resistente al agua» ni «hipoalergénico» (no está confirmado por escrito) ni 2 años de garantía.
{%- endcomment -%}
{%- case parte -%}
  {%- when 'historia' -%}
    {%- if product.handle == 'reloj-lune' -%}
      <div class="lu-hist">
        <figure class="lu-hist__grande">
          {%- assign foto = images['lune-editorial-detalle.jpg'] -%}
          {%- if foto -%}
            {{ foto | image_url: width: 2400 | image_tag: loading: 'lazy', sizes: '100vw', widths: '750, 1100, 1500, 2000, 2400' }}
          {%- endif -%}
        </figure>

        <ul class="lu-hist__datos" role="list">
          <li>
            <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="12" rx="5.2" ry="6.6"/><path d="M10 5.6V2.5h4v3.1M10 18.4v3.1h4v-3.1M12 9.2V12l1.8 1.3"/></svg>
            <span>Esfera ovalada de 12&nbsp;mm</span>
          </li>
          <li>
            <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="8" width="19" height="8" rx="1"/><path d="M6.5 8v3M10.5 8v4.5M14.5 8v3M18.5 8v4.5"/></svg>
            <span>Correa de 18&nbsp;cm ajustable</span>
          </li>
          <li>
            <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5.5c0 4.3-3 7.7-7 9.5-4-1.8-7-5.2-7-9.5V6z"/><path d="M9 12l2 2 4-4"/></svg>
            <span>Garantía de 3&nbsp;años</span>
          </li>
        </ul>

        <div class="lu-hist__texto">
          <p class="lu-hist__ceja">Reloj Lune</p>
          <h2 class="lu-hist__titulo">Pequeño, ovalado <em>y con piedras.</em></h2>
          <p>
            Una esfera de 12&nbsp;mm con el bisel dorado trenzado y seis piedras en tonos verdes, cada una en su marco.
            Se lleva como una pulsera fina: para todos los días o para regalar.
          </p>
        </div>

        <div class="lu-hist__collage">
          {%- assign nombres = 'lune-editorial-perfil.jpg,lune-editorial-curva.jpg,lune-editorial-toalla.jpg,lune-editorial-pelo.jpg' | split: ',' -%}
          {%- for nombre in nombres -%}
            {%- assign foto = images[nombre] -%}
            {%- if foto -%}
              <figure>
                {{ foto | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '50vw', widths: '400, 600, 800, 1100, 1400' }}
              </figure>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
{%- endcase -%}

{% stylesheet %}
  .lu-hist{display:grid;gap:6px;padding-inline:clamp(0px,1.6vw,24px)}
  .lu-hist figure{margin:0;overflow:hidden;background:#F2F4F2}
  .lu-hist img{display:block;width:100%;height:100%;object-fit:cover}
  .lu-hist__grande{aspect-ratio:4/5}
  @media (min-width:750px){.lu-hist__grande{aspect-ratio:2/1}}

  /* Franja de tres datos (como la de Olivia, con lo que es verdad del Lune) */
  .lu-hist__datos{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:0;padding:22px 12px;list-style:none;
    background:#F2F4F2;color:#16201B}
  .lu-hist__datos li{display:flex;flex-direction:column;align-items:center;gap:8px;text-align:center;
    font-family:var(--font-body--family);font-size:.6875rem;line-height:1.35;letter-spacing:.1em;text-transform:uppercase}
  .lu-hist__datos svg{flex:0 0 22px;color:#A6834A}
  @media (min-width:750px){
    .lu-hist__datos{display:flex;justify-content:center;gap:72px;padding:24px}
    .lu-hist__datos li{flex-direction:row;gap:12px;font-size:.8125rem}
  }

  /* Texto entre la franja y el collage */
  .lu-hist__texto{max-width:560px;margin-inline:auto;padding:56px 20px 50px;text-align:center}
  .lu-hist__ceja{margin:0 0 14px;font-family:var(--font-body--family);font-size:.75rem;letter-spacing:.22em;
    text-transform:uppercase;color:#A6834A}
  .lu-hist__titulo{margin:0 0 18px;font-family:var(--font-heading--family);font-weight:400;
    font-size:clamp(2rem,4.6vw,3rem);line-height:1.02;color:#16201B}
  .lu-hist__titulo em{display:block;font-style:italic}
  .lu-hist__texto p:last-child{margin:0;line-height:1.6;color:#3D4842}

  /* Collage: dos columnas, fotos 4:5 con una línea fina de separación */
  .lu-hist__collage{display:grid;grid-template-columns:1fr 1fr;gap:6px}
  .lu-hist__collage figure{aspect-ratio:4/5}
{% endstylesheet %}
