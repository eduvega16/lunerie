{
  "sections": {
    "migas": {
      "type": "section",
      "disabled": true,
      "blocks": {
        "migas": {
          "type": "text",
          "settings": {
            "text": "<p><a href=\"/\">Inicio</a> › {{ closest.product.title }}</p>",
            "width": "100%",
            "max_width": "normal",
            "alignment": "left",
            "type_preset": "paragraph",
            "font": "var(--font-body--family)",
            "font_size": "1rem",
            "line_height": "normal",
            "letter_spacing": "normal",
            "case": "none",
            "wrap": "pretty",
            "background": false,
            "background_color": "#00000026",
            "corner_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        }
      },
      "block_order": [
        "migas"
      ],
      "custom_css": [
        ".text-block p { font-size: 0.75rem; letter-spacing: 0.04em; } .text-block a { color: inherit; text-decoration: none; }"
      ],
      "settings": {
        "content_direction": "column",
        "section_width": "page-width",
        "gap": 0,
        "padding-block-start": 20,
        "padding-block-end": 0
      }
    },
    "main": {
      "type": "product-information",
      "blocks": {
        "media-gallery": {
          "type": "_product-media-gallery",
          "static": true,
          "settings": {
            "media_presentation": "grid",
            "media_columns": "two",
            "image_gap": 4,
            "large_first_image": false,
            "media_fit": "cover",
            "constrain_to_viewport": false,
            "icons_style": "arrow",
            "slideshow_controls_style": "thumbnails",
            "slideshow_mobile_controls_style": "counter",
            "thumbnail_position": "bottom",
            "thumbnail_width": 60,
            "thumbnail_radius": 0,
            "aspect_ratio": "1/1.25",
            "media_radius": 0,
            "extend_media": false,
            "zoom": true,
            "hide_variants": false
          },
          "blocks": {}
        },
        "product-details": {
          "type": "_product-details",
          "static": true,
          "settings": {
            "gap": 20,
            "sticky_details_desktop": true,
            "padding-block-start": 8,
            "padding-block-end": 24
          },
          "blocks": {
            "titulo": {
              "type": "product-title",
              "settings": {
                "type_preset": "custom",
                "font": "var(--font-heading--family)",
                "font_size": "1.5rem",
                "case": "uppercase",
                "letter_spacing": "loose",
                "line_height": "tight",
                "width": "100%"
              },
              "blocks": {}
            },
            "estrellas": {
              "type": "custom-liquid",
              "settings": {
                "custom_liquid": "{% render 'lunerie-opiniones', parte: 'mini', product: product %}"
              },
              "blocks": {}
            },
            "precio": {
              "type": "price",
              "settings": {
                "show_sale_price_first": true,
                "show_installments": false,
                "show_tax_info": false,
                "type_preset": "custom",
                "font_size": "1.125rem",
                "width": "fit-content"
              },
              "blocks": {}
            },
            "oferta": {
              "type": "custom-liquid",
              "settings": {
                "custom_liquid": "<div class=\"lu-oferta-ficha\"><p class=\"lu-oferta-ficha__t\"><span>Black Friday</span>2.ª pieza al 50 % · 3.ª gratis</p><p class=\"lu-oferta-ficha__p\">Mezcla relojes y joyas: se descuenta solo en la cesta. Hasta el 5 de diciembre.</p></div><style>.lu-oferta-ficha{font-family:var(--font-body--family)}.lu-oferta-ficha p{margin:0}.lu-oferta-ficha__t{display:flex;flex-wrap:wrap;align-items:baseline;gap:2px 12px;font-size:.9375rem;color:#16201B}.lu-oferta-ficha__t span{font-size:.75rem;font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:#CA3801}.lu-oferta-ficha__p{margin-top:4px!important;font-size:.8125rem;line-height:1.5;color:#3D4842}</style>"
              },
              "blocks": {}
            },
            "linea": {
              "type": "_divider",
              "settings": {
                "thickness": 1,
                "divider_color": "{{ settings.color_palette.color2 }}",
                "padding-block-start": 4,
                "padding-block-end": 4
              },
              "blocks": {}
            },
            "ventajas": {
              "type": "custom-liquid",
              "settings": {
                "custom_liquid": "<ul class=\"lu-ventajas\"><li>Envío gratis a península, con seguimiento · 7-12 días laborables</li><li>Para Navidad, pídelo antes del 5 de diciembre</li><li>Garantía de 3 años · 14 días para devolverlo</li></ul><style>.lu-ventajas{display:grid;gap:6px;margin:0;padding:0!important;list-style:none;font-family:var(--font-body--family);font-size:.8125rem;line-height:1.5;color:#3D4842}</style>"
              },
              "blocks": {}
            },
            "variantes": {
              "type": "variant-picker",
              "settings": {
                "variant_style": "buttons",
                "show_swatches": true
              },
              "blocks": {}
            },
            "comprar": {
              "type": "buy-buttons",
              "settings": {
                "stacking": true,
                "show_pickup_availability": false,
                "gift_card_form": true
              },
              "blocks": {
                "quantity": {
                  "type": "quantity",
                  "static": true,
                  "settings": {
                    "border_width": 1,
                    "border_radius": 0
                  },
                  "blocks": {}
                },
                "add-to-cart": {
                  "type": "add-to-cart",
                  "static": true,
                  "settings": {
                    "style_class": "button"
                  },
                  "blocks": {}
                },
                "accelerated-checkout": {
                  "type": "accelerated-checkout",
                  "static": true,
                  "settings": {},
                  "blocks": {}
                }
              },
              "block_order": []
            },
            "detalles": {
              "type": "accordion",
              "settings": {
                "icon": "plus",
                "dividers": true,
                "divider_color": "{{ settings.color_palette.color2 }}",
                "type_preset": "h6"
              },
              "blocks": {
                "descripcion": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Descripción",
                    "icon": "none",
                    "open_by_default": false
                  },
                  "blocks": {
                    "texto": {
                      "type": "product-description",
                      "settings": {
                        "text": "{{ closest.product.description }}",
                        "width": "100%",
                        "type_preset": "rte"
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "texto"
                  ]
                },
                "envio": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Envío",
                    "icon": "none",
                    "open_by_default": false
                  },
                  "blocks": {
                    "texto": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Gratis a península, con número de seguimiento por email. Plazo de entrega: 7-12 días laborables.</p><p>Por ahora no enviamos a Canarias, Ceuta ni Melilla.</p>",
                        "width": "100%",
                        "max_width": "normal",
                        "alignment": "left",
                        "type_preset": "rte",
                        "font": "var(--font-body--family)",
                        "font_size": "1rem",
                        "line_height": "normal",
                        "letter_spacing": "normal",
                        "case": "none",
                        "wrap": "pretty",
                        "background": false,
                        "background_color": "#00000026",
                        "corner_radius": 0,
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "texto"
                  ]
                },
                "devoluciones": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Devoluciones y garantía",
                    "icon": "none",
                    "open_by_default": false
                  },
                  "blocks": {
                    "texto": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Tienes 14 días desde que lo recibes para devolverlo: escríbenos y te explicamos cómo.</p><p>Las piezas personalizadas (con nombre o grabado) no admiten devolución porque se hacen solo para ti. Si llegan con un defecto o un error nuestro, las rehacemos.</p><p>Todas tienen la garantía legal de 3 años.</p>",
                        "width": "100%",
                        "max_width": "normal",
                        "alignment": "left",
                        "type_preset": "rte",
                        "font": "var(--font-body--family)",
                        "font_size": "1rem",
                        "line_height": "normal",
                        "letter_spacing": "normal",
                        "case": "none",
                        "wrap": "pretty",
                        "background": false,
                        "background_color": "#00000026",
                        "corner_radius": 0,
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "texto"
                  ]
                },
                "cuidados": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Cuidados",
                    "icon": "none",
                    "open_by_default": false
                  },
                  "blocks": {
                    "texto": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Ponte el perfume y la crema antes que la joya, quítatela para ducharte, nadar o hacer deporte y guárdala por separado para que no se raye.</p>",
                        "width": "100%",
                        "max_width": "normal",
                        "alignment": "left",
                        "type_preset": "rte",
                        "font": "var(--font-body--family)",
                        "font_size": "1rem",
                        "line_height": "normal",
                        "letter_spacing": "normal",
                        "case": "none",
                        "wrap": "pretty",
                        "background": false,
                        "background_color": "#00000026",
                        "corner_radius": 0,
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "texto"
                  ]
                },
                "agua": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "¿Se puede mojar?",
                    "icon": "none",
                    "open_by_default": false
                  },
                  "blocks": {
                    "texto": {
                      "type": "text",
                      "settings": {
                        "text": "<p>No. No es sumergible: quítatelo para lavarte las manos, ducharte o nadar. Una gota de lluvia no le pasa nada.</p>",
                        "width": "100%",
                        "max_width": "normal",
                        "alignment": "left",
                        "type_preset": "rte",
                        "font": "var(--font-body--family)",
                        "font_size": "1rem",
                        "line_height": "normal",
                        "letter_spacing": "normal",
                        "case": "none",
                        "wrap": "pretty",
                        "background": false,
                        "background_color": "#00000026",
                        "corner_radius": 0,
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "texto"
                  ]
                }
              },
              "block_order": [
                "descripcion",
                "agua",
                "envio",
                "devoluciones",
                "cuidados"
              ]
            },
            "combina": {
              "type": "custom-liquid",
              "settings": {
                "custom_liquid": "{% render 'lunerie-combina', product: product %}"
              },
              "blocks": {}
            },
            "leyenda": {
              "type": "custom-liquid",
              "settings": {
                "custom_liquid": "{% render 'lunerie-leyenda', product: product %}"
              },
              "blocks": {}
            }
          },
          "block_order": [
            "titulo",
            "estrellas",
            "precio",
            "oferta",
            "linea",
            "variantes",
            "comprar",
            "ventajas",
            "leyenda",
            "detalles",
            "combina"
          ]
        }
      },
      "block_order": [],
      "custom_css": [
        "ul { padding-inline-start: 1.1em; } ul li::marker { color: #A6834A; } .quantity-selector-wrapper { display: none; } .accelerated-checkout-block, .add-to-cart-icon { display: none; } @media (min-width: 750px) { .product-details { padding-inline: 56px 48px !important; } }"
      ],
      "settings": {
        "content_width": "content-full-width",
        "desktop_media_position": "left",
        "equal_columns": false,
        "limit_details_width": true,
        "gap": 0,
        "enable_sticky_add_to_cart": true,
        "background_color": "{{ settings.color_palette.background }}",
        "padding-block-start": 0,
        "padding-block-end": 48
      }
    },
    "opiniones": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "{% render 'lunerie-opiniones', parte: 'lista', product: product %}",
        "background_color": "",
        "section_width": "page-width",
        "padding-block-start": 48,
        "padding-block-end": 32
      }
    },
    "recomendados": {
      "type": "product-recommendations",
      "blocks": {
        "titulo": {
          "type": "text",
          "settings": {
            "text": "<h2>También te puede gustar</h2>",
            "width": "100%",
            "max_width": "normal",
            "alignment": "left",
            "type_preset": "h4",
            "font": "var(--font-body--family)",
            "font_size": "1rem",
            "line_height": "normal",
            "letter_spacing": "normal",
            "case": "none",
            "wrap": "pretty",
            "background": false,
            "background_color": "#00000026",
            "corner_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        },
        "static-product-card": {
          "type": "_product-card",
          "static": true,
          "settings": {
            "product_card_gap": 6
          },
          "blocks": {
            "foto": {
              "type": "_product-card-gallery",
              "settings": {
                "image_ratio": "adapt"
              },
              "blocks": {}
            },
            "nombre": {
              "type": "product-title",
              "settings": {
                "type_preset": "rte"
              },
              "blocks": {}
            },
            "precio": {
              "type": "price",
              "settings": {
                "type_preset": "paragraph"
              },
              "blocks": {}
            }
          },
          "block_order": [
            "foto",
            "nombre",
            "precio"
          ]
        }
      },
      "block_order": [
        "titulo"
      ],
      "settings": {
        "product": "{{ closest.product }}",
        "recommendation_type": "related",
        "layout_type": "grid",
        "max_products": 3,
        "columns": 3,
        "mobile_columns": "2",
        "columns_gap": 16,
        "rows_gap": 32,
        "section_width": "page-width",
        "gap": 28,
        "background_color": "{{ settings.color_palette.background }}",
        "padding-block-start": 48,
        "padding-block-end": 64
      }
    }
  },
  "order": [
    "migas",
    "main",
    "opiniones",
    "recomendados"
  ]
}