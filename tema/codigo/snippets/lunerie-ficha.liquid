            <li><i aria-hidden="true"></i>Acero inoxidable; el dorado, con baño de oro de 18K</li>
            <li><i aria-hidden="true"></i>Hasta 10 letras, tal cual las escribes</li>
            <li><i aria-hidden="true"></i>Doce colores de circonita: el de su mes o el que más le guste</li>
            <li><i aria-hidden="true"></i>Llega en su cajita de regalo</li>
          </ul>
        </div>
        <div class="lu-sg__fotos">
          <figure class="lu-sg__foto">
            <video data-lu-auto muted loop playsinline preload="none" aria-label="El collar en la mano, con la lágrima de cada mes"
              poster="https://cdn.shopify.com/s/files/1/1113/4065/0835/files/collar-piedra-mes.jpg?v=1794421185">
              <source src="https://cdn.shopify.com/videos/c/vp/e41943c70c03441391b72fc485a2307f/e41943c70c03441391b72fc485a2307f.HD-1080p-2.5Mbps-100903552.mp4" type="video/mp4">
            </video>
          </figure>
          <figure class="lu-sg__foto">
            <img src="https://cdn.shopify.com/s/files/1/1113/4065/0835/files/collar-signe-cajita-pegatina.jpg?v=1794421196&width=900"
              srcset="https://cdn.shopify.com/s/files/1/1113/4065/0835/files/collar-signe-cajita-pegatina.jpg?v=1794421196&width=600 600w, https://cdn.shopify.com/s/files/1/1113/4065/0835/files/collar-signe-cajita-pegatina.jpg?v=1794421196&width=900 900w, https://cdn.shopify.com/s/files/1/1113/4065/0835/files/collar-signe-cajita-pegatina.jpg?v=1794421196&width=1300 1300w"
              sizes="(min-width: 750px) 33vw, 50vw" width="1744" height="2180" loading="lazy"
              alt="El Collar Signé en su cajita de terciopelo beige, con la pegatina «Cajita de regalo incluida»">
          </figure>
        </div>
      </div>
      {%- render 'lunerie-ficha', parte: 'reproducir' -%}
    {%- endif -%}

  {%- when 'reproducir' -%}
    {%- comment -%} Vídeos con data-lu-auto: se reproducen solos (sin sonido) mientras se ven y se paran al salir.
      Si el móvil pide «reducir movimiento», no se mueven solos: se quedan en la foto con los controles. {%- endcomment -%}
    <script>
      (() => {
        const vids = [...document.querySelectorAll('video[data-lu-auto]:not([data-lu-visto])')];
        vids.forEach((v) => v.setAttribute('data-lu-visto', ''));
        if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
          vids.forEach((v) => { v.controls = true; v.removeAttribute('aria-hidden'); });
          return;
        }
        const io = new IntersectionObserver((es) => es.forEach((e) => {
          if (e.isIntersecting) e.target.play().catch(() => {}); else e.target.pause();
        }), { threshold: 0.4 });
        vids.forEach((v) => io.observe(v));
      })();
    </script>
{%- endcase -%}

{% stylesheet %}
  .lu-hist{display:grid;gap:6px;padding-inline:clamp(0px,1.6vw,24px)}
  .lu-hist figure{margin:0;overflow:hidden;background:#F2F4F2}
  .lu-hist img,.lu-hist video{display:block;width:100%;height:100%;object-fit:cover}
  .lu-hist__grande{aspect-ratio:4/5}
  @media (min-width:750px){.lu-hist__grande{aspect-ratio:2/1}}

  /* Franja de tres datos (como la de Olivia, con lo que es verdad del Lune) */
  .lu-hist__datos{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:0;padding:22px 12px;list-style:none;
    background:#F2F4F2;color:#16201B}
  .lu-hist__datos li{display:flex;flex-direction:column;align-items:center;gap:8px;text-align:center;
    font-family:var(--font-body--family);font-size:.6875rem;line-height:1.35;letter-spacing:.1em;text-transform:uppercase}
  .lu-hist__datos svg{flex:0 0 22px;color:#A6834A}
  @media (min-width:750px){
    .lu-hist__datos{display:flex;justify-content:center;gap:72px;padding:24px}
    .lu-hist__datos li{flex-direction:row;gap:12px;font-size:.8125rem}
  }

  /* Texto entre la franja y el collage */
  .lu-hist__texto{max-width:560px;margin-inline:auto;padding:56px 20px 50px;text-align:center}
  .lu-hist__ceja{margin:0 0 14px;font-family:var(--font-body--family);font-size:.75rem;letter-spacing:.22em;
    text-transform:uppercase;color:#A6834A}
  .lu-hist__titulo{margin:0 0 18px;font-family:var(--font-heading--family);font-weight:400;
    font-size:clamp(2rem,4.6vw,3rem);line-height:1.02;color:#16201B}
  .lu-hist__titulo em{display:block;font-style:italic}
  .lu-hist__texto p:last-child{margin:0;line-height:1.6;color:#3D4842}

  /* Collage: dos columnas, fotos 4:5 con una línea fina de separación */
  .lu-hist__collage{display:grid;grid-template-columns:1fr 1fr;gap:6px}
  .lu-hist__collage figure{aspect-ratio:4/5}

  /* «De cerca»: vídeos 9:16 en fila (en móvil se pasan con el dedo) */
  .lu-vid__titulo{margin:0 0 22px;text-align:center;font-family:var(--font-heading--family);font-weight:400;
    font-size:clamp(1.75rem,3.2vw,2.25rem);line-height:1.1;color:#16201B}
  .lu-vid__fila{display:flex;justify-content:center;gap:6px;overflow-x:auto;scroll-snap-type:x mandatory;
    scrollbar-width:none;padding-inline:16px;scroll-padding-inline:16px}
  .lu-vid__fila::-webkit-scrollbar{display:none}
  .lu-vid__item{flex:0 0 250px;margin:0;aspect-ratio:9/16;overflow:hidden;background:#F2F4F2;scroll-snap-align:start}
  .lu-vid video{display:block;width:100%;height:100%;object-fit:cover}
  @media (max-width:749px){
    .lu-vid__fila{justify-content:flex-start}
    .lu-vid__item{flex-basis:44vw}
  }

  /* Bloque del Collar Signé (11-nov): en PC, texto en un tercio y dos fotos 4:5; en el móvil, texto y fotos debajo */
  .lu-sg{display:grid;grid-template-columns:1fr 2fr;gap:48px;align-items:center;padding-inline:48px;color:#16201B}
  .lu-sg__ceja{margin:0 0 10px;font-size:.75rem;letter-spacing:.18em;text-transform:uppercase;color:#A6834A}
  .lu-sg__titulo{margin:0 0 18px;font-family:var(--font-heading--family);font-weight:400;
    font-size:clamp(2rem,3.4vw,2.75rem);line-height:1.05}
  .lu-sg__texto p{margin:0 0 18px;max-width:30rem;line-height:1.6}
  .lu-sg__lista{margin:0;padding:0!important;list-style:none;display:grid;gap:8px;font-size:.9375rem}
  .lu-sg__lista li{position:relative;padding-left:18px}
  .lu-sg__lista li i{position:absolute;left:0;top:.6em;width:6px;height:6px;border-radius:50%;
    background:#A6834A}
  .lu-sg__fotos{display:grid;grid-template-columns:1fr 1fr;gap:6px}
  .lu-sg__foto{margin:0;aspect-ratio:4/5;overflow:hidden;background:#F2F4F2}
  .lu-sg__foto video,.lu-sg__foto img{display:block;width:100%;height:100%;object-fit:cover}
  @media (max-width:749px){
    .lu-sg{grid-template-columns:1fr;gap:24px;padding-inline:16px}
  }

  /* «Así se lleva» (11-nov): vídeos del collar como historias de Instagram, con esquinas redondeadas */
  .lu-hst__titulo{margin:0 0 22px;text-align:center;font-family:var(--font-heading--family);font-weight:400;
    font-size:clamp(1.75rem,3.2vw,2.25rem);line-height:1.1;color:#16201B}
  .lu-hst__fila{display:flex;justify-content:center;gap:10px;overflow-x:auto;scroll-snap-type:x mandatory;
    scrollbar-width:none;padding-inline:16px;scroll-padding-inline:16px}
  .lu-hst__fila::-webkit-scrollbar{display:none}
  .lu-hst__item{position:relative;flex:0 0 200px;margin:0;aspect-ratio:9/16;overflow:hidden;border-radius:16px;
    background:#F2F4F2;scroll-snap-align:start}
  .lu-hst video{display:block;width:100%;height:100%;object-fit:cover}
  .lu-hst__sombra{position:absolute;inset:0 0 auto;height:72px;z-index:1;pointer-events:none;
    background:linear-gradient(rgba(0,0,0,.32),rgba(0,0,0,0))}
  .lu-hst__barra{position:absolute;top:8px;left:8px;right:8px;z-index:2;height:2px;border-radius:2px;
    background:rgba(255,255,255,.4);overflow:hidden}
  .lu-hst__barra i{display:block;height:100%;background:#fff;transform:scaleX(0);transform-origin:left}
  .lu-hst__quien{position:absolute;top:18px;left:10px;z-index:2;display:flex;align-items:center;gap:6px;
    font-size:.6875rem;font-weight:500;color:#fff;text-shadow:0 1px 2px rgba(0,0,0,.35)}
  .lu-hst__quien img{width:22px;height:22px;border-radius:50%;box-shadow:0 0 0 1.5px #fff}
  @media (max-width:749px){
    .lu-hst__fila{justify-content:flex-start;gap:8px}
    .lu-hst__item{flex-basis:40vw;border-radius:14px}
  }
  /* Las tarjetas son botones (se abren a pantalla completa) */
  .lu-hst__item{padding:0;border:0;cursor:pointer;font:inherit;color:inherit;text-align:left}
  .lu-hst__item:focus-visible{outline:2px solid #A6834A;outline-offset:3px}

  /* Visor a pantalla completa, como una historia (11-nov) */
  html.lu-sin-scroll{overflow:hidden}
  .lu-hstv{width:100vw;height:100dvh;max-width:none;max-height:none;margin:0;padding:0;border:0;background:transparent;
    color:#fff}
  .lu-hstv[open]{display:flex;align-items:center;justify-content:center;gap:28px}
  .lu-hstv::backdrop{background:rgba(10,14,12,.9)}
  .lu-hstv__marco{position:relative;height:min(92dvh,calc(92vw * 16 / 9));aspect-ratio:9/16;border-radius:18px;
    overflow:hidden;background:#000}
  .lu-hstv__marco video{display:block;width:100%;height:100%;object-fit:cover}
  .lu-hstv__barras{position:absolute;top:10px;left:10px;right:10px;z-index:2;display:flex;gap:4px}
  .lu-hstv__barras span{flex:1;height:2px;border-radius:2px;background:rgba(255,255,255,.4);overflow:hidden}
  .lu-hstv__barras i{display:block;height:100%;background:#fff;transform:scaleX(0);transform-origin:left}
  .lu-hstv__quien{position:absolute;top:22px;left:12px;z-index:2;display:flex;align-items:center;gap:8px;
    font-size:.8125rem;font-weight:500;text-shadow:0 1px 2px rgba(0,0,0,.35)}
  .lu-hstv__quien img{width:28px;height:28px;border-radius:50%;box-shadow:0 0 0 1.5px #fff}
  .lu-hstv__cerrar{position:absolute;top:16px;right:8px;z-index:3;width:40px;height:40px;display:grid;place-items:center;
    padding:0;border:0;background:transparent;color:#fff;cursor:pointer;filter:drop-shadow(0 1px 2px rgba(0,0,0,.4))}
  .lu-hstv__zona{position:absolute;top:64px;bottom:0;z-index:1;width:35%;padding:0;border:0;background:transparent;
    cursor:pointer}
  .lu-hstv__zona--ant{left:0}
  .lu-hstv__zona--sig{right:0}
  .lu-hstv__flecha{flex:0 0 44px;width:44px;height:44px;display:grid;place-items:center;padding:0;border:0;
    border-radius:50%;background:rgba(255,255,255,.92);color:#16201B;cursor:pointer}
  .lu-hstv button:focus-visible{outline:2px solid #A6834A;outline-offset:2px}
  @media (max-width:749px){
    .lu-hstv__marco{width:100vw;height:100dvh;aspect-ratio:auto;border-radius:0}
    .lu-hstv__flecha{display:none}
  }
{% endstylesheet %}
