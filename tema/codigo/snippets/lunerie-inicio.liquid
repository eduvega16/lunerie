    .lu-hn__fotos{position:relative;aspect-ratio:1/1.12;overflow:hidden;background:#F2F4F2}
    .lu-hn__foto{position:absolute;margin:0;filter:drop-shadow(0 1px 1px rgba(22,32,27,.16)) drop-shadow(0 8px 18px rgba(22,32,27,.22))}
    .lu-hn__papel{height:100%;padding:clamp(5px,1.5vw,11px);background:#FDFCF9;clip-path:var(--lu-papel-a)}
    .lu-hn__foto--centro .lu-hn__papel{clip-path:var(--lu-papel-b)}
    .lu-hn__recorte{height:100%;overflow:hidden}
    .lu-hn__papel img{display:block;width:100%;height:100%;object-fit:cover}
    /* Móvil (3-nov, fotos «para cada día»): la grande a la izquierda, porque la taza y el anillo están en su lado izquierdo */
    .lu-hn__foto--izquierda{z-index:1;top:4%;left:3%;width:66%;aspect-ratio:3/4;transform:rotate(-1.5deg)}
    .lu-hn__foto--centro{z-index:2;top:2%;right:2.5%;width:46%;aspect-ratio:4/3;transform:rotate(3deg)}
    .lu-hn__foto--derecha{z-index:3;bottom:2.5%;right:4%;width:44%;aspect-ratio:3/4;transform:rotate(-2.5deg)}
    /* 3-nov (Edu): en el móvil, las fotos más cerca de las joyas. Las fotos ya vienen algo acercadas (marca/revelar.py):
       aquí solo un poco más, hacia donde están el reloj, el anillo y el collar */
    .lu-hn__foto--izquierda img{transform:scale(1.06);transform-origin:48% 50%}
    .lu-hn__foto--centro img{transform:scale(1.04);transform-origin:50% 45%}
    .lu-hn__foto--derecha img{transform:scale(1.05);transform-origin:45% 44%}
    .lu-hn__promo{display:grid;justify-items:center;gap:12px;padding:8px 20px 44px;text-align:center}
    .lu-hn__oferta{margin:0;font-family:var(--font-body--family);font-size:.75rem;font-weight:500;letter-spacing:.22em;
      text-transform:uppercase;color:#CA3801}
    .lu-hn__marca{margin:0;font-family:var(--font-heading--family);font-weight:400;font-size:clamp(2rem,3.2vw,2.9rem);
      line-height:1.05;color:#16201B}
    .lu-hn__marca em{font-style:italic}
    .lu-hn__sub{margin:0;font-size:.9375rem;line-height:1.6;color:#3D4842}
    .lu-hn__acciones{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:14px 24px;margin-top:10px}
    .lu-hn__enlace{color:#16201B;text-underline-offset:4px;font-size:.875rem;letter-spacing:.08em}
    .lu-hn__nota{margin:6px 0 0;font-size:.75rem;letter-spacing:.04em;color:#6B746F;text-wrap:balance}
    @media (min-width:750px){
      /* PC: la del sofá en el centro y las otras dos a los lados, medio escondidas (izquierda) o encima (derecha) */
      /* 3-nov (Edu): a todo el ancho y más grandes (antes medían como mucho 680 px de alto en el centro de la pantalla) */
      .lu-hn__fotos{aspect-ratio:2.35/1}
      .lu-hn__foto--izquierda{top:6%;left:2.5%;width:27.5%;transform:rotate(-2deg)}
      .lu-hn__foto--centro{top:7%;right:auto;left:50%;width:46%;transform:translateX(-50%) rotate(-.8deg)}
      .lu-hn__foto--derecha{top:4%;bottom:auto;right:2.5%;width:27.5%;transform:rotate(2deg)}
      .lu-hn__foto img{transform:none}
      .lu-hn__promo{padding:40px 24px 48px}
    }

    /* Packs para regalar (2-nov): tarjetas en niebla; en móvil se deslizan, en PC tres en fila */
    .lu-packs{color:#16201B}
    .lu-packs__cab{max-width:46rem;margin:0 auto 32px;text-align:center}
    .lu-packs__cab .lu-titulo{margin:0 0 14px}
    .lu-packs__texto{margin:0;color:#3D4842;line-height:1.6}
    .lu-packs__lista{display:grid;grid-auto-flow:column;grid-auto-columns:86%;gap:14px;margin:0;padding:0 0 6px!important;
      list-style:none;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none}
    .lu-packs__lista::-webkit-scrollbar{display:none}
    .lu-packs__item{scroll-snap-align:start}
    .lu-pack{display:flex;flex-direction:column;gap:10px;height:100%;padding:16px 16px 22px;background:#F2F4F2}
    /* fotos siempre del mismo alto (8:5): con 2 piezas, dos 4:5; con 3, la primera grande y las otras dos apiladas */
    .lu-pack__fotos{display:grid;grid-template-columns:1fr 1fr;grid-auto-rows:1fr;gap:6px;aspect-ratio:8/5;overflow:hidden}
    .lu-pack__fotos--3 .lu-pack__foto:first-child{grid-row:span 2}
    .lu-pack__foto{position:relative;display:block;min-height:0;overflow:hidden;background:#fff}
    .lu-pack__foto img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
    .lu-pack__nombre{margin:8px 0 0;font-family:var(--font-heading--family);font-weight:400;font-size:1.6rem;line-height:1.1}
    .lu-pack__frase{margin:0;font-size:.875rem;line-height:1.5;color:#3D4842}
    .lu-pack__piezas{display:grid;gap:8px;margin:6px 0 0;padding:0!important;list-style:none}
    .lu-pack__piezas li{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:38px;
      padding-top:8px;border-top:1px solid #E2E6E3;font-size:.875rem}
    .lu-pack__piezas a{color:#16201B;text-decoration:none}
    .lu-pack__piezas select{max-width:58%;padding:7px 10px;border:1px solid #C9CFCB;border-radius:0;background:#fff;
      font:inherit;font-size:.8125rem;color:#16201B}
    .lu-pack__precio{display:grid;gap:4px;margin:8px 0 0}
    .lu-pack__final{font-family:var(--font-heading--family);font-size:1.9rem;line-height:1}
    .lu-pack__antes{font-size:.8125rem;color:#5B6660}
    .lu-pack__boton{width:100%;margin-top:6px;border:0;cursor:pointer}
    .lu-pack__boton:disabled{opacity:.7;cursor:wait}
    @media (min-width:750px){
      .lu-packs__lista{grid-auto-flow:row;grid-template-columns:repeat(3,1fr);overflow:visible;gap:20px}
      .lu-pack__precio{margin-top:auto;padding-top:8px}   /* en PC, precio y botón alineados en las tres */
    }

    /* Escaparates y reseñas del inicio (1-nov): fila que se desliza, a todo el ancho, con flechas en PC */
    .lu-esc{--lu-esc-margen:clamp(16px,4vw,48px);color:#16201B}
    .lu-esc__cab{max-width:46rem;margin:0 auto 32px;padding-inline:var(--lu-esc-margen);text-align:center}
    .lu-esc__cab .lu-titulo{margin:0 0 16px}
    .lu-esc__texto{margin:0;font-size:.9375rem;line-height:1.7;color:#3D4842}
    .lu-esc__marco{position:relative}
    .lu-esc__lista{display:flex;gap:14px;margin:0;padding:0 var(--lu-esc-margen) 4px;list-style:none;overflow-x:auto;
      scroll-snap-type:x mandatory;scroll-padding-inline:var(--lu-esc-margen);scrollbar-width:none;-webkit-overflow-scrolling:touch}
    .lu-esc__lista::-webkit-scrollbar{display:none}
    .lu-esc__lista:focus-visible{outline:2px solid #006039;outline-offset:2px}
    .lu-esc__item{flex:0 0 62vw;scroll-snap-align:start;min-width:0}
    .lu-esc--joyas .lu-esc__item{flex-basis:84vw}
    .lu-esc__tarjeta{display:flex;flex-direction:column;gap:3px;color:inherit;text-decoration:none}
    .lu-esc__fotos{display:grid;grid-template-columns:1fr 1fr;aspect-ratio:4/5;margin-bottom:10px;overflow:hidden;background:#F2F4F2}
    .lu-esc--joyas .lu-esc__fotos{aspect-ratio:8/5}
    .lu-esc__escena,.lu-esc__producto{position:relative;display:block;min-width:0;overflow:hidden}
    .lu-esc__fotos img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;
      transition:transform .9s cubic-bezier(.2,.7,.2,1)}
    .lu-esc__nombre{font-family:var(--font-heading--family);font-size:1.2rem;line-height:1.2}
    .lu-esc__frase{font-family:var(--font-heading--family);font-style:italic;font-size:.95rem;line-height:1.3;color:#6B746F}
    .lu-esc__precio{display:flex;gap:8px;align-items:baseline;margin-top:2px;font-size:.9375rem}
    .lu-esc__precio s{font-size:.8125rem;color:#8A928D}
    .lu-esc__tarjeta:focus-visible{outline:2px solid #006039;outline-offset:4px}
    .lu-esc__pie{margin:28px 0 0;text-align:center}
    .lu-esc__todos{color:#16201B;text-underline-offset:4px;font-size:.875rem;letter-spacing:.06em}
    .lu-esc__flecha{position:absolute;top:calc(50% - 44px);z-index:2;display:flex;align-items:center;justify-content:center;
      width:40px;height:40px;padding:0;border:1px solid #E2E6E3;border-radius:50%;background:#fff;color:#16201B;cursor:pointer;
      box-shadow:0 2px 10px rgba(22,32,27,.08)}
    .lu-esc__flecha[hidden]{display:none}
    .lu-esc__flecha--ant{left:calc(var(--lu-esc-margen) - 20px)}
    .lu-esc__flecha--sig{right:calc(var(--lu-esc-margen) - 20px)}
    .lu-esc__media{display:inline-flex;align-items:center;gap:10px;margin:0;font-size:.9375rem;color:#3D4842}
    .lu-esc__media .lu-estrellas{font-size:18px}
    .lu-esc--opiniones .lu-esc__item{flex-basis:86vw}
    .lu-esc__op{display:grid;grid-template-columns:38% 1fr;height:100%;background:#F2F4F2}
    .lu-esc__op-foto{position:relative;display:block;min-height:220px;overflow:hidden}
    .lu-esc__op-foto img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
    .lu-esc__op-cuerpo{display:flex;flex-direction:column;gap:10px;padding:20px 18px}
    .lu-esc__op-texto{margin:0;font-size:.875rem;line-height:1.6;color:#3D4842}
    .lu-esc__op-quien{display:flex;flex-wrap:wrap;align-items:center;gap:4px 10px;margin:auto 0 0;font-size:.8125rem}
    .lu-esc__op-quien small{flex-basis:100%;padding-left:34px;font-size:.6875rem;color:#6B746F}
    .lu-esc__op-raya{width:24px;height:1px;background:#16201B}
    .lu-esc__op-pieza{font-size:.75rem;color:#16201B;text-underline-offset:3px}
    /* PC (3-nov): las tarjetas llenan el ancho (con un ancho fijo, en la pantalla grande de Edu quedaba un hueco a la
       derecha). --n = tarjetas que se ven a la vez; si hay más, se deslizan; si hay menos, la fila se centra. */
    @media (min-width:750px){
      .lu-esc{--n:3}
      .lu-esc--joyas,.lu-esc--opiniones{--n:2}
      .lu-esc__lista{justify-content:flex-start;justify-content:safe center}
      .lu-esc__item,.lu-esc--joyas .lu-esc__item,.lu-esc--opiniones .lu-esc__item{flex-basis:calc((100% - (var(--n) - 1) * 14px) / var(--n))}
      .lu-esc__op-foto{min-height:260px}
    }
    @media (min-width:1100px){.lu-esc--relojes{--n:4}.lu-esc--joyas,.lu-esc--opiniones{--n:3}}
    @media (min-width:1500px){.lu-esc--relojes{--n:5}}
    @media (min-width:1700px){.lu-esc--joyas,.lu-esc--opiniones{--n:4}}
    @media (max-width:749px){.lu-esc__flecha{display:none}}
    @media (hover:hover){.lu-esc__tarjeta:hover .lu-esc__fotos img{transform:scale(1.04)}}
    @media (prefers-reduced-motion:no-preference){.lu-esc__lista{scroll-behavior:smooth}}
    @media (prefers-reduced-motion:reduce){.lu-esc__fotos img{transition:none}}

    /* Collar Signé (5-nov): fotos grandes y texto a un lado, sin cajas de color */
    .lu-col{display:grid;grid-template-columns:1fr;padding-inline:clamp(16px,4vw,48px);color:#16201B}
    .lu-col__foto{position:relative;display:block;aspect-ratio:4/5;overflow:hidden;background:#F2F4F2}
    .lu-col__foto img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .6s ease}
    .lu-col__foto--suelto{display:none}
    .lu-col__texto{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:36px 8px 8px;
      text-align:center}
    .lu-col__texto .lu-titulo{margin:0 0 16px}
    .lu-col .lu-ceja{order:0;margin:0 0 14px}
    .lu-col__sub{max-width:30ch;margin:0;line-height:1.6;color:#3D4842}
    .lu-col__lagrimas{display:flex;flex-wrap:wrap;justify-content:center;gap:10px;margin:26px 0 0;padding:0!important;
      list-style:none}
    .lu-col__lagrimas li{width:11px;height:11px;border-radius:0 50% 50% 50%;transform:rotate(45deg);background:var(--t);
      box-shadow:inset 0 0 0 1px rgba(22,32,27,.14)}
    .lu-col__leyenda{margin:12px 0 0;font-size:.75rem;letter-spacing:.06em;color:#6B746F}
    .lu-col__precio{margin:24px 0 18px;font-size:1.0625rem}
    .lu-col__nota{margin:14px 0 0;font-size:.8125rem;color:#6B746F}
    @media (min-width:750px){.lu-col{grid-template-columns:1fr 1fr;gap:4px}.lu-col__texto{padding:48px}}
    @media (min-width:1100px){.lu-col{grid-template-columns:1fr 1fr 1fr}.lu-col__foto--suelto{display:block}}
    @media (min-width:1700px){.lu-col .lu-titulo{font-size:3.4rem}.lu-col__sub{max-width:32ch;font-size:1.125rem}
      .lu-col__lagrimas{gap:13px}.lu-col__lagrimas li{width:14px;height:14px}.lu-col__leyenda,.lu-col__nota{font-size:.875rem}
      .lu-col__precio{font-size:1.25rem}.lu-col .lu-boton{padding:20px 40px;font-size:.875rem}}
    @media (hover:hover){.lu-col__foto:hover img{transform:scale(1.03)}}
    @media (prefers-reduced-motion:reduce){.lu-col__foto img{transition:none}}
{% endstylesheet %}
