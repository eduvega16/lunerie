{
  "sections": {
    "portada": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "{% render 'lunerie-inicio', parte: 'hero-video' %}",
        "background_color": "",
        "section_width": "full-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
    "piezas": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "{% render 'lunerie-inicio', parte: 'piezas' %}",
        "background_color": "{{ settings.color_palette.background }}",
        "section_width": "page-width",
        "padding-block-start": 56,
        "padding-block-end": 24
      }
    },
    "como_es": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "{% render 'lunerie-inicio', parte: 'como-es' %}",
        "background_color": "",
        "section_width": "page-width",
        "padding-block-start": 48,
        "padding-block-end": 56
      }
    },
    "dudas": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "{% render 'lunerie-inicio', parte: 'dudas' %}",
        "background_color": "",
        "section_width": "page-width",
        "padding-block-start": 64,
        "padding-block-end": 56
      }
    },
    "destacado": {
      "disabled": true,
      "type": "featured-product-information",
      "blocks": {
        "media-gallery": {
          "type": "_featured-product-information-carousel",
          "static": true,
          "settings": {
            "constrain_to_viewport": true,
            "media_fit": "cover",
            "media_radius": 0,
            "extend_media": false,
            "hide_variants": true,
            "slideshow_controls_style": "thumbnails",
            "slideshow_mobile_controls_style": "dots",
            "thumbnail_position": "bottom",
            "thumbnail_width": 56
          },
          "blocks": {}
        },
        "product-details": {
          "type": "_product-details",
          "static": true,
          "settings": {
            "gap": 24,
            "sticky_details_desktop": false,
            "padding-block-start": 24,
            "padding-block-end": 24
          },
          "blocks": {
            "ceja": {
              "type": "text",
              "settings": {
                "text": "<p>ELIGE EL TUYO</p>",
                "width": "100%",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "custom",
                "font": "var(--font-body--family)",
                "font_size": "0.75rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
                "background": false,
                "background_color": "#00000026",
                "corner_radius": 0,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0,
                "text_color": "#A6834A"
              },
              "blocks": {}
            },
            "cabecera": {
              "type": "group",
              "settings": {
                "content_direction": "column",
                "horizontal_alignment_flex_direction_column": "flex-start",
                "gap": 10,
                "width": "fill"
              },
              "blocks": {
                "titulo": {
                  "type": "product-title",
                  "settings": {
                    "type_preset": "h2"
                  },
                  "blocks": {}
                },
                "precio": {
                  "type": "price",
                  "settings": {
                    "show_sale_price_first": true,
                    "show_installments": false,
                    "show_tax_info": false,
                    "type_preset": "paragraph"
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "titulo",
                "precio"
              ]
            },
            "variantes": {
              "type": "variant-picker",
              "settings": {
                "variant_style": "buttons",
                "show_swatches": true
              },
              "blocks": {}
            },
            "comprar": {
              "type": "buy-buttons",
              "settings": {
                "stacking": true,
                "show_pickup_availability": false
              },
              "blocks": {
                "quantity": {
                  "type": "quantity",
                  "static": true,
                  "settings": {
                    "border_width": 1,
                    "border_radius": 0
                  },
                  "blocks": {}
                },
                "add-to-cart": {
                  "type": "add-to-cart",
                  "static": true,
                  "settings": {
                    "style_class": "button"
                  },
                  "blocks": {}
                },
                "accelerated-checkout": {
                  "type": "accelerated-checkout",
                  "static": true,
                  "settings": {},
                  "blocks": {}
                }
              },
              "block_order": []
            },
            "ver_ficha": {
              "type": "button",
              "settings": {
                "label": "Ver todos los detalles",
                "link": "{{ closest.product.url }}",
                "style_class": "link",
                "width": "fit-content"
              },
              "blocks": {}
            }
          },
          "block_order": [
            "ceja",
            "cabecera",
            "variantes",
            "comprar",
            "ver_ficha"
          ]
        }
      },
      "block_order": [],
      "custom_css": [
        ".quantity-selector-wrapper { display: none; } .button-unstyled, a.link { text-decoration: underline; text-underline-offset: 4px; } @media (max-width: 749px) { .product-information__media { display: none; } }"
      ],
      "settings": {
        "product": "reloj-lune",
        "content_width": "content-center-aligned",
        "desktop_media_position": "left",
        "equal_columns": true,
        "limit_details_width": true,
        "gap": 48,
        "background_color": "{{ settings.color_palette.background }}",
        "padding-block-start": 56,
        "padding-block-end": 24
      }
    },
    "promesas": {
      "type": "section",
      "blocks": {
        "envio": {
          "type": "group",
          "settings": {
            "content_direction": "column",
            "horizontal_alignment_flex_direction_column": "center",
            "gap": 8,
            "width": "fill"
          },
          "blocks": {
            "t": {
              "type": "text",
              "settings": {
                "text": "<h3>Envío gratis</h3>",
                "width": "100%",
                "max_width": "normal",
                "alignment": "center",
                "type_preset": "h6",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
                "background": false,
                "background_color": "#00000026",
                "corner_radius": 0,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            },
            "p": {
              "type": "text",
              "settings": {
                "text": "<p>A península, con seguimiento por email.</p>",
                "width": "100%",
                "max_width": "normal",
                "alignment": "center",
                "type_preset": "rte",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
                "background": false,
                "background_color": "#00000026",
                "corner_radius": 0,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            }
          },
          "block_order": [
            "t",
            "p"
          ]
        },
        "devolucion": {
          "type": "group",
          "settings": {
            "content_direction": "column",
            "horizontal_alignment_flex_direction_column": "center",
            "gap": 8,
            "width": "fill"
          },
          "blocks": {
            "t": {
              "type": "text",
              "settings": {
                "text": "<h3>14 días para devolverlo</h3>",
                "width": "100%",
                "max_width": "normal",
                "alignment": "center",
                "type_preset": "h6",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
                "background": false,
                "background_color": "#00000026",
                "corner_radius": 0,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            },
            "p": {
              "type": "text",
              "settings": {
                "text": "<p>Si no te convence, nos lo devuelves. Salvo piezas personalizadas.</p>",
                "width": "100%",
                "max_width": "normal",
                "alignment": "center",
                "type_preset": "rte",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
                "background": false,
                "background_color": "#00000026",
                "corner_radius": 0,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            }
          },
          "block_order": [
            "t",
            "p"
          ]
        },
        "garantia": {
          "type": "group",
          "settings": {
            "content_direction": "column",
            "horizontal_alignment_flex_direction_column": "center",
            "gap": 8,
            "width": "fill"
          },
          "blocks": {
            "t": {
              "type": "text",
              "settings": {
                "text": "<h3>Garantía de 3 años</h3>",
                "width": "100%",
                "max_width": "normal",
                "alignment": "center",
                "type_preset": "h6",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
                "background": false,
                "background_color": "#00000026",
                "corner_radius": 0,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            },
            "p": {
              "type": "text",
              "settings": {
                "text": "<p>Si falla, te lo reparamos o te lo cambiamos.</p>",
                "width": "100%",
                "max_width": "normal",
                "alignment": "center",
                "type_preset": "rte",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
                "background": false,
                "background_color": "#00000026",
                "corner_radius": 0,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            }
          },
          "block_order": [
            "t",
            "p"
          ]
        }
      },
      "block_order": [
        "envio",
        "devolucion",
        "garantia"
      ],
      "settings": {
        "content_direction": "row",
        "vertical_on_mobile": true,
        "horizontal_alignment": "space-between",
        "vertical_alignment": "flex-start",
        "gap": 32,
        "section_width": "page-width",
        "border": "solid",
        "border_width": 1,
        "border_color": "#E2E6E3",
        "padding-block-start": 48,
        "padding-block-end": 48
      }
    }
  },
  "order": [
    "portada",
    "destacado",
    "piezas",
    "como_es",
    "dudas",
    "promesas"
  ]
}