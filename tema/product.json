{
  "sections": {
    "migas": {
      "type": "section",
      "blocks": {
        "migas": {
          "type": "text",
          "settings": {
            "text": "<p><a href=\"/\">Inicio</a> › {{ closest.product.title }}</p>",
            "width": "100%",
            "max_width": "normal",
            "alignment": "left",
            "type_preset": "paragraph",
            "font": "var(--font-body--family)",
            "font_size": "1rem",
            "line_height": "normal",
            "letter_spacing": "normal",
            "case": "none",
            "wrap": "pretty",
            "background": false,
            "background_color": "#00000026",
            "corner_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        }
      },
      "block_order": [
        "migas"
      ],
      "custom_css": [
        ".text-block p { font-size: 0.75rem; letter-spacing: 0.04em; } .text-block a { color: inherit; text-decoration: none; }"
      ],
      "settings": {
        "content_direction": "column",
        "section_width": "page-width",
        "gap": 0,
        "padding-block-start": 20,
        "padding-block-end": 0
      }
    },
    "main": {
      "type": "product-information",
      "blocks": {
        "media-gallery": {
          "type": "_product-media-gallery",
          "static": true,
          "settings": {
            "media_presentation": "grid",
            "media_columns": "two",
            "image_gap": 0,
            "large_first_image": true,
            "media_fit": "cover",
            "constrain_to_viewport": false,
            "icons_style": "arrow",
            "slideshow_controls_style": "thumbnails",
            "slideshow_mobile_controls_style": "thumbnails",
            "thumbnail_position": "bottom",
            "thumbnail_width": 60,
            "thumbnail_radius": 0,
            "aspect_ratio": "1/1.25",
            "media_radius": 0,
            "extend_media": false,
            "zoom": true,
            "hide_variants": false
          },
          "blocks": {}
        },
        "product-details": {
          "type": "_product-details",
          "static": true,
          "settings": {
            "gap": 20,
            "sticky_details_desktop": true,
            "padding-block-start": 8,
            "padding-block-end": 24
          },
          "blocks": {
            "titulo": {
              "type": "product-title",
              "settings": {
                "type_preset": "custom",
                "font": "var(--font-heading--family)",
                "font_size": "1.5rem",
                "case": "uppercase",
                "letter_spacing": "loose",
                "line_height": "tight",
                "width": "100%"
              },
              "blocks": {}
            },
            "estrellas": {
              "type": "custom-liquid",
              "settings": {
                "custom_liquid": "{% render 'lunerie-opiniones', parte: 'mini', product: product %}"
              },
              "blocks": {}
            },
            "precio": {
              "type": "group",
              "settings": {
                "content_direction": "row",
                "vertical_on_mobile": false,
                "horizontal_alignment": "flex-start",
                "vertical_alignment": "center",
                "gap": 14,
                "width": "fill"
              },
              "blocks": {
                "importe": {
                  "type": "price",
                  "settings": {
                    "show_sale_price_first": true,
                    "show_installments": false,
                    "show_tax_info": false,
                    "type_preset": "custom",
                    "font_size": "1.125rem",
                    "width": "fit-content"
                  },
                  "blocks": {}
                },
                "envio": {
                  "type": "custom-liquid",
                  "settings": {
                    "custom_liquid": "<span class=\"lu-envio\">Envío gratis a península</span><style>.lu-envio{display:inline-block;padding:5px 10px;background:#F2F4F2;font-family:var(--font-body--family);font-size:.75rem;letter-spacing:.04em;color:#3D4842;white-space:nowrap}</style>"
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "importe",
                "envio"
              ]
            },
            "linea": {
              "type": "_divider",
              "settings": {
                "thickness": 1,
                "divider_color": "{{ settings.color_palette.color2 }}",
                "padding-block-start": 4,
                "padding-block-end": 4
              },
              "blocks": {}
            },
            "ventajas": {
              "type": "group",
              "settings": {
                "content_direction": "column",
                "gap": 12,
                "width": "fill"
              },
              "blocks": {
                "navidad": {
                  "type": "custom-liquid",
                  "settings": {
                    "custom_liquid": "<p class=\"lu-urgencia\"><span class=\"lu-punto\" aria-hidden=\"true\"></span>Para Navidad, pídelo antes del 5 de diciembre</p><style>.lu-urgencia,.lu-regalo{font-family:var(--font-body--family);font-weight:var(--font-body--weight)}.lu-urgencia{display:flex;align-items:center;gap:12px;margin:0;font-size:1rem;color:#B3261E}.lu-punto{position:relative;flex:0 0 9px;width:9px;height:9px;margin-inline:4px 5px;border-radius:50%;background:#B3261E}.lu-punto::after{content:'';position:absolute;inset:0;border-radius:50%;background:#B3261E;animation:lu-latido 1.6s ease-out infinite}@keyframes lu-latido{0%{transform:scale(1);opacity:.7}100%{transform:scale(2.6);opacity:0}}@media (prefers-reduced-motion:reduce){.lu-punto::after{animation:none;opacity:0}}</style>"
                  },
                  "blocks": {}
                },
                "envio": {
                  "type": "group",
                  "settings": {
                    "content_direction": "row",
                    "vertical_on_mobile": false,
                    "horizontal_alignment": "flex-start",
                    "vertical_alignment": "center",
                    "gap": 12,
                    "width": "fill"
                  },
                  "blocks": {
                    "icono": {
                      "type": "icon",
                      "settings": {
                        "icon": "truck",
                        "width": 18,
                        "icon_color": "#16201B"
                      },
                      "blocks": {}
                    },
                    "texto": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Envío gratis a península, con seguimiento</p>",
                        "width": "100%",
                        "max_width": "normal",
                        "alignment": "left",
                        "type_preset": "custom",
                        "font": "var(--font-body--family)",
                        "font_size": "1rem",
                        "line_height": "normal",
                        "letter_spacing": "normal",
                        "case": "none",
                        "wrap": "pretty",
                        "background": false,
                        "background_color": "#00000026",
                        "corner_radius": 0,
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "icono",
                    "texto"
                  ]
                },
                "garantia": {
                  "type": "group",
                  "settings": {
                    "content_direction": "row",
                    "vertical_on_mobile": false,
                    "horizontal_alignment": "flex-start",
                    "vertical_alignment": "center",
                    "gap": 12,
                    "width": "fill"
                  },
                  "blocks": {
                    "icono": {
                      "type": "icon",
                      "settings": {
                        "icon": "star",
                        "width": 18,
                        "icon_color": "#16201B"
                      },
                      "blocks": {}
                    },
                    "texto": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Garantía de 3 años + 14 días para devolverlo</p>",
                        "width": "100%",
                        "max_width": "normal",
                        "alignment": "left",
                        "type_preset": "custom",
                        "font": "var(--font-body--family)",
                        "font_size": "1rem",
                        "line_height": "normal",
                        "letter_spacing": "normal",
                        "case": "none",
                        "wrap": "pretty",
                        "background": false,
                        "background_color": "#00000026",
                        "corner_radius": 0,
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "icono",
                    "texto"
                  ]
                }
              },
              "block_order": [
                "navidad",
                "envio",
                "garantia"
              ]
            },
            "variantes": {
              "type": "variant-picker",
              "settings": {
                "variant_style": "buttons",
                "show_swatches": true
              },
              "blocks": {}
            },
            "comprar": {
              "type": "buy-buttons",
              "settings": {
                "stacking": true,
                "show_pickup_availability": false,
                "gift_card_form": true
              },
              "blocks": {
                "quantity": {
                  "type": "quantity",
                  "static": true,
                  "settings": {
                    "border_width": 1,
                    "border_radius": 0
                  },
                  "blocks": {}
                },
                "add-to-cart": {
                  "type": "add-to-cart",
                  "static": true,
                  "settings": {
                    "style_class": "button"
                  },
                  "blocks": {}
                },
                "accelerated-checkout": {
                  "type": "accelerated-checkout",
                  "static": true,
                  "settings": {},
                  "blocks": {}
                }
              },
              "block_order": []
            },
            "detalles": {
              "type": "accordion",
              "settings": {
                "icon": "plus",
                "dividers": true,
                "divider_color": "{{ settings.color_palette.color2 }}",
                "type_preset": "h6"
              },
              "blocks": {
                "descripcion": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Descripción",
                    "icon": "none",
                    "open_by_default": false
                  },
                  "blocks": {
                    "texto": {
                      "type": "product-description",
                      "settings": {
                        "width": "100%",
                        "type_preset": "rte"
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "texto"
                  ]
                },
                "medida": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Ajustar la correa",
                    "icon": "none",
                    "open_by_default": false
                  },
                  "blocks": {
                    "texto": {
                      "type": "text",
                      "settings": {
                        "text": "<p>La correa mide 18 cm. Si tu muñeca es más fina (menos de 16 cm), quita uno o dos eslabones: en cualquier relojería te lo hacen al momento.</p>",
                        "width": "100%",
                        "max_width": "normal",
                        "alignment": "left",
                        "type_preset": "rte",
                        "font": "var(--font-body--family)",
                        "font_size": "1rem",
                        "line_height": "normal",
                        "letter_spacing": "normal",
                        "case": "none",
                        "wrap": "pretty",
                        "background": false,
                        "background_color": "#00000026",
                        "corner_radius": 0,
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "texto"
                  ]
                },
                "agua": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "¿Se puede mojar?",
                    "icon": "none",
                    "open_by_default": false
                  },
                  "blocks": {
                    "texto": {
                      "type": "text",
                      "settings": {
                        "text": "<p>No. No es sumergible: quítatelo para lavarte las manos, ducharte o nadar. Una gota de lluvia no le pasa nada.</p>",
                        "width": "100%",
                        "max_width": "normal",
                        "alignment": "left",
                        "type_preset": "rte",
                        "font": "var(--font-body--family)",
                        "font_size": "1rem",
                        "line_height": "normal",
                        "letter_spacing": "normal",
                        "case": "none",
                        "wrap": "pretty",
                        "background": false,
                        "background_color": "#00000026",
                        "corner_radius": 0,
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "texto"
                  ]
                },
                "envio": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Envío",
                    "icon": "none",
                    "open_by_default": false
                  },
                  "blocks": {
                    "texto": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Gratis a península, con número de seguimiento por email. Plazo de entrega: 7-12 días laborables.</p><p>Por ahora no enviamos a Canarias, Ceuta ni Melilla.</p>",
                        "width": "100%",
                        "max_width": "normal",
                        "alignment": "left",
                        "type_preset": "rte",
                        "font": "var(--font-body--family)",
                        "font_size": "1rem",
                        "line_height": "normal",
                        "letter_spacing": "normal",
                        "case": "none",
                        "wrap": "pretty",
                        "background": false,
                        "background_color": "#00000026",
                        "corner_radius": 0,
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "texto"
                  ]
                },
                "devoluciones": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Devoluciones y garantía",
                    "icon": "none",
                    "open_by_default": false
                  },
                  "blocks": {
                    "texto": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Tienes 14 días desde que lo recibes para devolverlo: escríbenos y te explicamos cómo.</p><p>Las piezas personalizadas (con nombre o grabado) no admiten devolución porque se hacen solo para ti. Si llegan con un defecto o un error nuestro, las rehacemos.</p><p>Todas tienen la garantía legal de 3 años.</p>",
                        "width": "100%",
                        "max_width": "normal",
                        "alignment": "left",
                        "type_preset": "rte",
                        "font": "var(--font-body--family)",
                        "font_size": "1rem",
                        "line_height": "normal",
                        "letter_spacing": "normal",
                        "case": "none",
                        "wrap": "pretty",
                        "background": false,
                        "background_color": "#00000026",
                        "corner_radius": 0,
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "texto"
                  ]
                },
                "cuidados": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Cuidados",
                    "icon": "none",
                    "open_by_default": false
                  },
                  "blocks": {
                    "texto": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Ponte el perfume y la crema antes que la pieza, quítatela para hacer deporte y guárdala en su caja cuando no la lleves.</p>",
                        "width": "100%",
                        "max_width": "normal",
                        "alignment": "left",
                        "type_preset": "rte",
                        "font": "var(--font-body--family)",
                        "font_size": "1rem",
                        "line_height": "normal",
                        "letter_spacing": "normal",
                        "case": "none",
                        "wrap": "pretty",
                        "background": false,
                        "background_color": "#00000026",
                        "corner_radius": 0,
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "texto"
                  ]
                }
              },
              "block_order": [
                "descripcion",
                "medida",
                "agua",
                "envio",
                "devoluciones",
                "cuidados"
              ]
            }
          },
          "block_order": [
            "titulo",
            "estrellas",
            "precio",
            "linea",
            "ventajas",
            "variantes",
            "comprar",
            "detalles"
          ]
        }
      },
      "block_order": [],
      "custom_css": [
        "ul { padding-inline-start: 1.1em; } ul li::marker { color: #A6834A; } .quantity-selector-wrapper { display: none; } @media (min-width: 750px) { .product-information__grid--half .product-information__media { box-sizing: border-box; padding-inline-start: 30px; } .product-information__grid--half.product-information__grid--limit-details .product-details > .group-block { --details-max-width: 34rem; } }"
      ],
      "settings": {
        "content_width": "content-full-width",
        "desktop_media_position": "left",
        "equal_columns": true,
        "limit_details_width": true,
        "gap": 0,
        "enable_sticky_add_to_cart": true,
        "background_color": "{{ settings.color_palette.background }}",
        "padding-block-start": 16,
        "padding-block-end": 48
      }
    },
    "videos": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "{% render 'lunerie-ficha', parte: 'videos', product: product %}",
        "background_color": "",
        "section_width": "full-width",
        "padding-block-start": 40,
        "padding-block-end": 48
      },
      "disabled": true
    },
    "historia": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "{% render 'lunerie-ficha', parte: 'historia', product: product %}",
        "background_color": "",
        "section_width": "full-width",
        "padding-block-start": 0,
        "padding-block-end": 24
      }
    },
    "opiniones": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "{% render 'lunerie-opiniones', parte: 'lista', product: product %}",
        "background_color": "",
        "section_width": "page-width",
        "padding-block-start": 48,
        "padding-block-end": 32
      }
    },
    "recomendados": {
      "type": "product-recommendations",
      "blocks": {
        "titulo": {
          "type": "text",
          "settings": {
            "text": "<h2>También te puede gustar</h2>",
            "width": "100%",
            "max_width": "normal",
            "alignment": "left",
            "type_preset": "h4",
            "font": "var(--font-body--family)",
            "font_size": "1rem",
            "line_height": "normal",
            "letter_spacing": "normal",
            "case": "none",
            "wrap": "pretty",
            "background": false,
            "background_color": "#00000026",
            "corner_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        },
        "static-product-card": {
          "type": "_product-card",
          "static": true,
          "settings": {
            "product_card_gap": 6
          },
          "blocks": {
            "foto": {
              "type": "_product-card-gallery",
              "settings": {
                "image_ratio": "adapt"
              },
              "blocks": {}
            },
            "nombre": {
              "type": "product-title",
              "settings": {
                "type_preset": "rte"
              },
              "blocks": {}
            },
            "precio": {
              "type": "price",
              "settings": {
                "type_preset": "paragraph"
              },
              "blocks": {}
            }
          },
          "block_order": [
            "foto",
            "nombre",
            "precio"
          ]
        }
      },
      "block_order": [
        "titulo"
      ],
      "settings": {
        "product": "{{ closest.product }}",
        "recommendation_type": "related",
        "layout_type": "grid",
        "max_products": 3,
        "columns": 3,
        "mobile_columns": "2",
        "columns_gap": 16,
        "rows_gap": 32,
        "section_width": "page-width",
        "gap": 28,
        "background_color": "{{ settings.color_palette.background }}",
        "padding-block-start": 48,
        "padding-block-end": 64
      }
    }
  },
  "order": [
    "migas",
    "main",
    "videos",
    "historia",
    "opiniones",
    "recomendados"
  ]
}