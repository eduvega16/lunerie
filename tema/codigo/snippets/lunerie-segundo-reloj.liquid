{%- comment -%} Generado por tema/build.py (PROMO): aviso de la promo en la cesta {%- endcomment -%}
{%- assign lu_n = cart.item_count -%}
{%- if lu_n > 0 -%}
<div class="lu-promo">
  {%- if lu_n == 1 -%}
    <p class="lu-promo__t">Añade otra pieza y la más barata te sale al 50 %</p>
    {%- assign lu_item = cart.items.first -%}{%- assign lu_m = lu_item.original_price -%}{%- assign lu_vistas = 0 -%}
    <ul class="lu-extra" role="list">
    {%- assign lu_lista = 'aros-boucle,anillo-duo,pendientes-larme,collar-lune' | split: ',' -%}
    {%- for lu_h in lu_lista -%}
      {%- assign p = all_products[lu_h] -%}
      {%- if p.available and p.handle != lu_item.product.handle and lu_vistas < 3 -%}
        {%- assign lu_vistas = lu_vistas | plus: 1 -%}
        {%- assign lu_baja = p.price | at_most: lu_m | divided_by: 2 -%}{%- assign lu_paga = p.price | minus: lu_baja -%}
      <li class="lu-extra__i"><form class="lu-extra__f" action="{{ routes.cart_add_url }}" method="post">
        <a class="lu-extra__img" href="{{ p.url }}" tabindex="-1">{{ p.featured_image | image_url: width: 300 | image_tag: loading: 'lazy', alt: p.title, sizes: '140px' }}</a>
        <span class="lu-extra__n">{{ p.title }}</span>
        <span class="lu-extra__p"><s>{{ p.price | money }}</s> {{ lu_paga | money }}</span>
        {%- if p.has_only_default_variant -%}
        <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}">
        {%- else -%}
        <select class="lu-extra__s" name="id" aria-label="{{ p.title | escape }}: {{ p.options.first | escape }}">{%- for v in p.variants -%}{%- if v.available -%}<option value="{{ v.id }}">{{ v.title }}</option>{%- endif -%}{%- endfor -%}</select>
        {%- endif -%}
        <input type="hidden" name="quantity" value="1"><input type="hidden" name="return_to" value="{{ routes.cart_url }}">
        <button type="submit" class="lu-extra__btn">Añadir</button>
      </form></li>
      {%- endif -%}
    {%- endfor -%}
    </ul>
  {%- elsif lu_n == 2 -%}
    <p class="lu-promo__t">Añade una tercera y la más barata te sale gratis</p>
  {%- else -%}
    <p class="lu-promo__t">Tu descuento ya está en la cesta</p>
  {%- endif -%}
</div>
<style>.lu-promo{margin:0 0 16px;padding:14px 0 14px 16px;background:#006039;color:#fff;display:grid;gap:12px}.lu-promo p{margin:0;padding-right:16px}.lu-promo__t{font-size:.8125rem;letter-spacing:.08em;text-transform:uppercase}.lu-extra{list-style:none;margin:0;padding:0 16px 2px 0!important;display:flex;gap:12px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none}.lu-extra::-webkit-scrollbar{display:none}.lu-extra__i{flex:0 0 216px;scroll-snap-align:start}.lu-extra__f{margin:0;display:grid;grid-template-columns:64px 1fr;grid-template-rows:auto auto minmax(30px,auto) auto;column-gap:10px;row-gap:4px;align-content:start}.lu-extra__img{grid-row:1/span 4;display:block;aspect-ratio:4/5;background:#F2F4F2;overflow:hidden}.lu-extra__img img{width:100%;height:100%;object-fit:cover;display:block}.lu-extra__n{font-size:.8125rem;line-height:1.25}.lu-extra__p{font-size:.8125rem}.lu-extra__p s{opacity:.65;margin-right:4px}.lu-extra__s{font:inherit;font-size:.75rem;color:#16201B;background:#fff;border:0;border-radius:0;padding:4px 6px;width:100%;min-height:30px}.lu-extra__btn{appearance:none;border:0;border-radius:0;background:#fff;color:#006039;font:inherit;font-size:.6875rem;letter-spacing:.14em;text-transform:uppercase;padding:8px 6px;cursor:pointer;min-height:32px;grid-column:2;grid-row:4}.lu-extra__btn:disabled{opacity:.6}.lu-extra__btn:focus-visible,.lu-extra__s:focus-visible{outline:2px solid #fff;outline-offset:2px}.cart-drawer__content>.lu-promo{margin:16px var(--cart-drawer-padding,16px) 0}.cart-drawer__items{flex-shrink:0}.cart-page>.lu-promo{margin-top:16px}@media screen and (min-width:750px){.cart-page>.lu-promo{grid-column:1;grid-row:2;align-self:start}.cart-page:has(>.lu-promo)>.cart-page__items{grid-row:3}}</style>
<script>if(!window.luExtra){window.luExtra=1;document.addEventListener('submit',function(e){var f=e.target.closest&&e.target.closest('.lu-extra__f');if(!f)return;e.preventDefault();var b=f.querySelector('button');b.disabled=true;b.textContent='Añadiendo…';fetch('{{ routes.cart_add_url }}.js',{method:'POST',body:new FormData(f),headers:{'Accept':'application/json'}}).then(function(r){if(!r.ok)throw 0;location.href='{{ routes.cart_url }}'}).catch(function(){f.submit()})})}</script>
{%- endif -%}
