  {%- when 'historias' -%}
    {%- comment -%} 11-nov (Edu, visto en otras tiendas como «As Seen On You»): fila de vídeos verticales del Collar
      Signé con aspecto de historias de Instagram (barra de progreso arriba y @luneriejewelry). Título honesto: son
      vídeos nuestros hechos con IA, no de clientas → nunca «As seen on you», «nuestras clientas» ni nombres de
      personas. Los vídeos los prepara y sube marca/historias_collar.py (URL en marca/videos-ficha/collar-urls.json):
      «mp4|foto», separados por comas. {%- endcomment -%}
    {%- if product.handle == 'collar-signe' -%}
      {%- assign videos = 'https://cdn.shopify.com/videos/c/vp/dbe9011fe237464d87b723e1e471ca87/dbe9011fe237464d87b723e1e471ca87.HD-720p-1.6Mbps-100899523.mp4|https://cdn.shopify.com/s/files/1/1113/4065/0835/files/collar-sarah-mirada.jpg?v=1794419504,https://cdn.shopify.com/videos/c/vp/4e682bb4fb604ccab29bced715f7974b/4e682bb4fb604ccab29bced715f7974b.HD-720p-1.6Mbps-100902905.mp4|https://cdn.shopify.com/s/files/1/1113/4065/0835/files/collar-mano-marta.jpg?v=1794420880,https://cdn.shopify.com/videos/c/vp/44fbafe694384436bc2e7f4cfffad26b/44fbafe694384436bc2e7f4cfffad26b.HD-720p-1.6Mbps-100903037.mp4|https://cdn.shopify.com/s/files/1/1113/4065/0835/files/collar-madre-hija-cuellos.jpg?v=1794420947,https://cdn.shopify.com/videos/c/vp/d9575ff3e7044af7b96546dc35b9878a/d9575ff3e7044af7b96546dc35b9878a.HD-720p-1.6Mbps-100899652.mp4|https://cdn.shopify.com/s/files/1/1113/4065/0835/files/collar-carmen-espejo.jpg?v=1794419548,https://cdn.shopify.com/videos/c/vp/73c44b669469495c95400b0345aad033/73c44b669469495c95400b0345aad033.HD-720p-1.6Mbps-100903203.mp4|https://cdn.shopify.com/s/files/1/1113/4065/0835/files/collar-hermanas-mesa.jpg?v=1794421016,https://cdn.shopify.com/videos/c/vp/60d736a0e9c34041a2060db6d6759eb8/60d736a0e9c34041a2060db6d6759eb8.HD-720p-1.6Mbps-100903357.mp4|https://cdn.shopify.com/s/files/1/1113/4065/0835/files/collar-madre-hija-palmas.jpg?v=1794421086' | split: ',' -%}
      <div class="lu-hst">
        <h2 class="lu-hst__titulo">Así se lleva</h2>
        <div class="lu-hst__fila">
          {%- for v in videos -%}
            {%- assign partes = v | split: '|' -%}
            <button type="button" class="lu-hst__item" data-lu-hst="{{ forloop.index0 }}" data-lu-video="{{ partes[0] }}"
              data-lu-foto="{{ partes[1] }}" aria-label="Ver el vídeo {{ forloop.index }} de {{ videos.size }} a pantalla completa">
              <video data-lu-auto data-lu-historia muted loop playsinline preload="none" aria-hidden="true" poster="{{ partes[1] }}">
                <source src="{{ partes[0] }}" type="video/mp4">
              </video>
              <span class="lu-hst__sombra" aria-hidden="true"></span>
              <span class="lu-hst__barra" aria-hidden="true"><i></i></span>
              <span class="lu-hst__quien" aria-hidden="true">
                {%- if settings.favicon != blank -%}{{ settings.favicon | image_url: width: 64 | image_tag: alt: '', loading: 'lazy', width: 22, height: 22 }}{%- endif -%}
                luneriejewelry
              </span>
            </button>
          {%- endfor -%}
        </div>
      </div>
      {%- comment -%} 11-nov (Edu, visto en Lucce): al tocar un vídeo se abre a pantalla completa como una historia:
        barritas de progreso (una por vídeo), @luneriejewelry, X para cerrar; al acabar pasa al siguiente y tras el
        último se cierra. PC: flechas a los lados. Móvil: tocar a la izquierda/derecha o deslizar; hacia abajo, cerrar.
        Sin botón de sonido: los clips no llevan audio. {%- endcomment -%}
      <dialog class="lu-hstv" aria-label="Vídeos del Collar Signé">
        <button type="button" class="lu-hstv__flecha" data-lu-ant aria-label="Vídeo anterior">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
        </button>
        <div class="lu-hstv__marco">
          <video playsinline muted preload="auto" aria-hidden="true"></video>
          <span class="lu-hst__sombra" aria-hidden="true"></span>
          <span class="lu-hstv__barras" aria-hidden="true">
            {%- for v in videos -%}<span><i></i></span>{%- endfor -%}
          </span>
          <span class="lu-hstv__quien" aria-hidden="true">
            {%- if settings.favicon != blank -%}{{ settings.favicon | image_url: width: 64 | image_tag: alt: '', loading: 'lazy', width: 28, height: 28 }}{%- endif -%}
            luneriejewelry
          </span>
          <button type="button" class="lu-hstv__zona lu-hstv__zona--ant" data-lu-ant aria-label="Vídeo anterior"></button>
          <button type="button" class="lu-hstv__zona lu-hstv__zona--sig" data-lu-sig aria-label="Vídeo siguiente"></button>
          <button type="button" class="lu-hstv__cerrar" data-lu-cerrar aria-label="Cerrar">
            <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
          </button>
        </div>
        <button type="button" class="lu-hstv__flecha" data-lu-sig aria-label="Vídeo siguiente">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
        </button>
      </dialog>
      <script>
        (() => {
          // La barrita de arriba de cada tarjeta avanza con su vídeo, como en las historias de Instagram
          document.querySelectorAll('video[data-lu-historia]').forEach((v) => {
            const barra = v.parentElement.querySelector('.lu-hst__barra i');
            v.addEventListener('timeupdate', () => {
              if (v.duration) barra.style.transform = `scaleX(${v.currentTime / v.duration})`;
            });
          });
          // Visor a pantalla completa
          const items = [...document.querySelectorAll('.lu-hst [data-lu-hst]')];   // ojo: data-lu-abrir ya lo usa el panel de piedras
          const dlg = document.querySelector('.lu-hstv');
          if (!items.length || !dlg) return;
          const vid = dlg.querySelector('video');
          const barras = [...dlg.querySelectorAll('.lu-hstv__barras i')];
          let actual = 0;
          const pintar = (fraccion) => barras.forEach((b, i) => {
            b.style.transform = `scaleX(${i < actual ? 1 : i > actual ? 0 : fraccion})`;
          });
          const cargar = (i) => {
            actual = i;
            vid.poster = items[i].dataset.luFoto;
            vid.src = items[i].dataset.luVideo;
            pintar(0);
            vid.play().catch(() => {});
          };
          const cerrar = () => { vid.pause(); vid.removeAttribute('src'); vid.load(); if (dlg.open) dlg.close(); };
          const sig = () => (actual < items.length - 1 ? cargar(actual + 1) : cerrar());
          const ant = () => cargar(Math.max(0, actual - 1));
          items.forEach((it, i) => it.addEventListener('click', () => {
            dlg.showModal();
            document.documentElement.classList.add('lu-sin-scroll');
            cargar(i);
          }));
          dlg.addEventListener('close', () => {
            document.documentElement.classList.remove('lu-sin-scroll');
            vid.pause();
            items[actual]?.focus({ preventScroll: true });
          });
          vid.addEventListener('timeupdate', () => { if (vid.duration) pintar(vid.currentTime / vid.duration); });
          vid.addEventListener('ended', sig);
          dlg.querySelectorAll('[data-lu-sig]').forEach((b) => b.addEventListener('click', sig));
          dlg.querySelectorAll('[data-lu-ant]').forEach((b) => b.addEventListener('click', ant));
          dlg.querySelector('[data-lu-cerrar]').addEventListener('click', cerrar);
          dlg.addEventListener('click', (e) => { if (e.target === dlg) cerrar(); });   // clic fuera del vídeo
          dlg.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowRight') sig();
            if (e.key === 'ArrowLeft') ant();
          });
          // Deslizar en el móvil: a los lados cambia de vídeo; hacia abajo, cierra
          let x0 = 0, y0 = 0;
          dlg.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; }, { passive: true });
          dlg.addEventListener('touchend', (e) => {
            const dx = e.changedTouches[0].clientX - x0, dy = e.changedTouches[0].clientY - y0;
            if (dy > 90 && Math.abs(dy) > Math.abs(dx)) cerrar();
            else if (Math.abs(dx) > 60 && Math.abs(dx) > Math.abs(dy)) (dx < 0 ? sig : ant)();
          }, { passive: true });
        })();
      </script>
      {%- render 'lunerie-ficha', parte: 'reproducir' -%}
    {%- endif -%}

  {%- when 'signe' -%}
    {%- comment -%} 11-nov (Edu, visto en Lucce Jewelry): bloque del Collar Signé bajo los vídeos: texto + dos fotos.
      · La de la mano: la lágrima cambia de color mes a mes (marca/piedra_cambia.py; sin IA, la foto real teñida).
      · La de la cajita: con la pegatina «Cajita de regalo incluida» (marca/pegatina_cajita.py).
      Solo cosas confirmadas: baño de oro de 18K (QIUHAN por escrito, 11-nov; solo el dorado), circonita, cajita.
      Nada de «waterproof», «no se oscurece» ni «hipoalergénico». {%- endcomment -%}
    {%- if product.handle == 'collar-signe' -%}
      <div class="lu-sg">
        <div class="lu-sg__texto">
          <p class="lu-sg__ceja">Collar Signé</p>
          <h2 class="lu-sg__titulo">Su nombre, <em>su piedra.</em></h2>
          <p>Su nombre en letra de firma y, colgando en el centro, una lágrima del color de su mes, o del que más le guste. Un regalo
            que es solo suyo.</p>
