{%- comment -%} Generado por tema/build.py (PROMO): barra de progreso de la promo en la cesta {%- endcomment -%}
{%- assign lu_n = cart.item_count -%}
{%- if lu_n > 0 -%}{%- assign lu_paso = lu_n | at_most: 3 -%}
<div class="lu-promo" role="status">
  <p class="lu-promo__t">{%- if lu_n == 1 -%}Añade otra pieza y la 2.ª te sale <strong>al 50 %</strong>{%- elsif lu_n == 2 -%}Añade una tercera y te sale <strong>gratis</strong>{%- else -%}Black Friday · <strong>tu descuento ya está aplicado</strong>{%- endif -%}</p>
  <div class="lu-promo__barra" aria-hidden="true"><span style="width:{% if lu_paso == 1 %}0{% elsif lu_paso == 2 %}50{% else %}100{% endif %}%"></span></div>
  <ol class="lu-promo__pasos" aria-hidden="true"><li class="is-on">1 pieza</li><li{% if lu_paso >= 2 %} class="is-on"{% endif %}>2.ª al 50 %</li><li{% if lu_paso >= 3 %} class="is-on"{% endif %}>3.ª gratis</li></ol>
</div>
<style>.lu-promo{margin:0 0 16px;display:grid;gap:8px;color:#16201B}.lu-promo__t{margin:0;font-size:.875rem;line-height:1.35}.lu-promo__t strong{font-weight:500}.lu-promo__barra{position:relative;height:3px;background:#E3E6E3;margin:6px 6px 0}.lu-promo__barra span{position:absolute;inset:0 auto 0 0;background:#006039;transition:width .4s}.lu-promo__pasos{list-style:none;margin:0;padding:0!important;display:flex;justify-content:space-between;font-size:.6875rem;letter-spacing:.06em;text-transform:uppercase;color:#7A827D}.lu-promo__pasos li.is-on{color:#006039}.cart-drawer__content>.lu-promo{margin:16px var(--cart-drawer-padding,16px) 0}.cart-page>.lu-promo{margin-top:16px}@media screen and (min-width:750px){.cart-page>.lu-promo{grid-column:1;grid-row:2;align-self:start}.cart-page:has(>.lu-promo)>.cart-page__items{grid-row:3}}</style>
{%- endif -%}
