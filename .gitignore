__pycache__/
*.pyc
.claude/*
# la oficina (29-oct): los agentes y el comando sí se versionan; el resto de .claude (contraseña de la tienda, logs, tmp) no
!.claude/agents/
!.claude/commands/
oficina/salida/
tema/tienda/
tema/fotos_prueba/

# Claves locales (Higgsfield, etc.): nunca en git
.env
.env.local

# Originales PNG de las fotos IA (30-oct): en git van las copias JPG
marca/fotos-ia/fichas/*.png
marca/fotos-ia/campana-hora/*.png
marca/fotos-ia/portada-navidad/*.png
marca/fotos-ia/portada-dia/*.png
marca/fotos-ia/combinados/*.png
# planos intermedios de los vídeos de la campaña (los vuelve a sacar marca/campana_bf.py)
marca/fotos-ia/campana-bf/*-plano-*.jpg
# versión descartada del collar (colgaba las piedras como dijes)
marca/fotos-ia/joyas/collar-lune-cuello-v1.png

# Vídeos de otras marcas bajados de TikTok (solo referencia, no son nuestros)
ssstik.io_*
oficina/publicaciones.log
marca/fotos-ia/collar/*.png

# anuncios animados (HyperFrames, 4-nov): sin node_modules ni vídeos de prueba
marca/anuncios-hf/node_modules/
marca/anuncios-hf/renders/
marca/anuncios-hf/.hyperframes/
marca/anuncios-hf/assets/img/
marca/anuncios-hf/assets/fonts/
marca/anuncios-hf/assets/gsap.min.js
marca/anuncios-hf/index.html
# originales PNG de los vídeos UGC del collar (5-nov): en git van los recortes JPG de clips/
marca/fotos-ia/ugc-collar/*.png
marca/fotos-ia/ugc-collar-carmen/*.png
