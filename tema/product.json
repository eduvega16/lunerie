                  "blocks": {
                    "texto": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Gratis a península, con número de seguimiento por email. Plazo de entrega: [PLAZO] días laborables.</p><p>Por ahora no enviamos a Canarias, Ceuta ni Melilla.</p>",
